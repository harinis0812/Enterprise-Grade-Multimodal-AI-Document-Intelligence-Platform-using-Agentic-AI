# Database Configuration
# Default for local development is SQLite: sqlite:///./docuai.db
# For PostgreSQL (Docker Compose or local PostgreSQL):
POSTGRES_USER=docuai
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=docuai
DATABASE_URL=sqlite:///./docuai.db

# MLOps Experiment Tracking
MLFLOW_TRACKING_URI=mlruns

# Enterprise Security Configuration
# Set JWT_SECRET_KEY to a cryptographically secure random string of at least 32 characters
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Authenticated Field-Level Encryption Key (Fernet / 32 url-safe base64-encoded bytes)
# Must be distinct from JWT_SECRET_KEY
DOCUMENT_ENCRYPTION_KEY=change-this-to-a-valid-fernet-key-32-base64-bytes=

# API Rate Limiting Configuration
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute

# Generative AI Q&A Configuration (Google Gemini)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
QA_TOP_K=5
QA_CHUNK_SIZE=900
QA_CHUNK_OVERLAP=150

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
